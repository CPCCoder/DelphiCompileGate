<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{C2F16D5B-A6D1-41E8-8E15-4E1B45C2D10A}</ProjectGuid>
        <ProjectVersion>20.1</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <MainSource>DelphiCompileGate.dpk</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <ProjectName Condition="'$(ProjectName)'==''">DelphiCompileGate</ProjectName>
        <TargetedPlatforms>1</TargetedPlatforms>
        <AppType>Package</AppType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <Base>true</Base>
        <DCGIDEOutputRoot>$(BDSCOMMONDIR)\DelphiCompileGate\$(Platform)\$(Config)</DCGIDEOutputRoot>
        <DCC_DcuOutput>$(DCGIDEOutputRoot)</DCC_DcuOutput>
        <DCC_ExeOutput>$(DCGIDEOutputRoot)</DCC_ExeOutput>
        <DCC_BplOutput>$(DCGIDEOutputRoot)</DCC_BplOutput>
        <DCC_DcpOutput>$(DCGIDEOutputRoot)</DCC_DcpOutput>
        <DCC_UnitSearchPath>$(BDS)\source\rtl\common;$(BDS)\source\rtl\win;$(BDS)\source\ToolsAPI;$(BDS)\source\Property Editors;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_UsePackage>rtl;vcl;designide;$(DCC_UsePackage)</DCC_UsePackage>
        <DCC_Description>Delphi Compile Gate</DCC_Description>
        <GenDll>true</GenDll>
        <GenPackage>true</GenPackage>
        <SanitizedProjectName>DelphiCompileGate</SanitizedProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
        <DCC_RangeChecking>true</DCC_RangeChecking>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
        <DCC_DebugInformation>0</DCC_DebugInformation>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="rtl.dcp"/>
        <DCCReference Include="vcl.dcp"/>
        <DCCReference Include="designide.dcp"/>
        <DCCReference Include="..\Src\DelphiCompileGate.BuildInfo.pas"/>
        <DCCReference Include="..\Src\DelphiCompileGate.Compiler.pas"/>
        <DCCReference Include="..\Src\DelphiCompileGate.Consts.pas"/>
        <DCCReference Include="..\Src\DelphiCompileGate.MessageHook.pas"/>
        <DCCReference Include="..\Src\DelphiCompileGate.Register.pas"/>
        <DCCReference Include="..\Src\DelphiCompileGate.ProtocolV2.pas"/>
        <DCCReference Include="..\Src\DelphiCompileGate.Settings.pas"/>
        <DCCReference Include="..\Src\DelphiCompileGate.SettingsDialog.pas"/>
        <DCCReference Include="..\Src\DelphiCompileGate.Watch.pas"/>
        <DCCReference Include="..\Src\DelphiCompileGate.Wizard.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Package</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">DelphiCompileGate.dpk</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
